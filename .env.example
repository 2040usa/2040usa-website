# Public browser configuration (safe placeholders only)
NEXT_PUBLIC_SUPABASE_URL=https://your-development-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_a_turnstile_site_key

# Server and CLI configuration. Never expose these to browser code.
DATABASE_URL=postgresql://postgres.project-ref:password@db.project-ref.supabase.co:5432/postgres?sslmode=require
SUPABASE_EXPECTED_PROJECT_REF=your-development-project-ref
SUPABASE_PROJECT_ID=your-development-project-ref
SUPABASE_ACCESS_TOKEN=replace_in_private_environment_only
SUPABASE_DB_PASSWORD=replace_in_private_environment_only
APP_DEPLOYMENT_ENV=development
NEXT_PUBLIC_APP_DEPLOYMENT_ENV=development
